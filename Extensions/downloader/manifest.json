{
  "manifest_version": 3,
  "name": "Fast Downloader",
  "version": "1.0",
  "description": "Speeds up big browser downloads by fetching the file in pieces over several connections at once.",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "offscreen", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fast Downloader",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
}
